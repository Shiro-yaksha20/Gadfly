# Discord Developer Portal -> your application -> Bot -> Token
DISCORD_BOT_TOKEN=your_bot_token_here

# Your own Discord user ID (enable Developer Mode in Discord settings,
# right-click your name, "Copy User ID")
OWNER_DISCORD_USER_ID=your_user_id_here

# How often (in minutes) to re-ping about open tickets
PING_INTERVAL_MINUTES=30

# Port for the health-check web server (Render/Railway set this automatically)
PORT=3000

# Google Calendar (from Google Cloud Console -> OAuth client, Desktop app type)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Generated once by running: npm run get-google-token
GOOGLE_REFRESH_TOKEN=your_refresh_token
# Usually just "primary" (your main calendar)
GOOGLE_CALENDAR_ID=primary

# Web dashboard login (visit https://your-app.onrender.com/dashboard)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=pick_a_real_password_here
